# ==============================================================================
# GOLDEN MINUTE EMERGENCY BACKEND CONFIGURATION (.env)
# ==============================================================================

# Central ML Service API URL (ML_project)
# Local development:
ML_SERVICE_URL=http://127.0.0.1:5000
# Deployed cloud production:
# ML_SERVICE_URL=https://<your-ml-service-domain>

# Database Configuration (SQLite default in dev, PostgreSQL in prod)
DATABASE_URL=sqlite:///./accident_response.db

# Security & JWT Token Secrets
SECRET_KEY=super-secret-jwt-emergency-key-981247192

# Optional Google Maps API Key
GOOGLE_MAPS_API_KEY=

# Optional Firebase FCM Configuration
FCM_SERVER_KEY=
FIREBASE_CREDENTIALS_PATH=
