# ==============================================================================
# GOLDEN MINUTE EMERGENCY FRONTEND CONFIGURATION (.env)
# ==============================================================================

# Central ML Service URL (Used by PhoneCamera for real-time AI scanning)
# Local development:
VITE_ML_SERVICE_URL=http://localhost:5000
# Deployed cloud production:
# VITE_ML_SERVICE_URL=https://<your-ml-service-domain>

# Golden Minute Backend API URL (Vite dev server proxies /api to port 8000 by default)
# VITE_BACKEND_API_URL=http://localhost:8000
